# math.tejstead.com — static site, built by the heilbronn-site repo and
# rsynced to /srv/www/math. This file is rsynced to /srv/caddy/sites/ by that
# repo's deploy.sh; never edit it on the server.
math.tejstead.com {
	root * /srv/www/math

	# Nothing lives at / yet; send visitors to the site.
	redir / /heilbronn/ temporary

	# Hashed assets are immutable by construction; everything else caches
	# briefly so a deploy propagates within minutes.
	@immutable path /heilbronn/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@pages not path /heilbronn/assets/*
	header @pages Cache-Control "public, max-age=300, must-revalidate"

	header -Server

	# The build emits .br and .gz siblings for every text asset, so serving
	# compressed costs zero CPU. encode only kicks in for the stragglers.
	file_server {
		precompressed br gzip
	}
	encode zstd gzip

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /heilbronn/404.html
		file_server
	}

	log {
		output file /data/access-math.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
